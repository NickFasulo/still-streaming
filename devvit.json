{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "still-streaming",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs",
    "externalEndpoints": {
      "quiz-now": {
        "endpoint": "/external/quiz-now",
        "scopes": ["install", "global"]
      },
      "slate-now": {
        "endpoint": "/external/slate-now",
        "scopes": ["install", "global"]
      },
      "resolve-now": {
        "endpoint": "/external/resolve-now",
        "scopes": ["install", "global"]
      }
    }
  },
  "permissions": {
    "reddit": true,
    "redis": true,
    "http": {
      "enable": true,
      "domains": [
        "www.galaxymovies.app"
      ]
    }
  },
  "settings": {
    "subreddit": {
      "post_days": {
        "type": "multiSelect",
        "label": "Quiz post days",
        "helpText": "Days of the week (UTC) the daily quiz post is created.",
        "options": [
          {
            "label": "Monday",
            "value": "1"
          },
          {
            "label": "Tuesday",
            "value": "2"
          },
          {
            "label": "Wednesday",
            "value": "3"
          },
          {
            "label": "Thursday",
            "value": "4"
          },
          {
            "label": "Friday",
            "value": "5"
          },
          {
            "label": "Saturday",
            "value": "6"
          },
          {
            "label": "Sunday",
            "value": "0"
          }
        ],
        "defaultValue": [
          "2",
          "4",
          "6"
        ]
      }
    }
  },
  "scheduler": {
    "tasks": {
      "daily-quiz": {
        "endpoint": "/internal/scheduler/daily-quiz",
        "cron": "0 15 * * *"
      },
      "weekly-slate": {
        "endpoint": "/internal/scheduler/weekly-slate",
        "cron": "30 15 * * 1"
      },
      "weekly-resolve": {
        "endpoint": "/internal/scheduler/weekly-resolve",
        "cron": "0 22 * * 0"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Post today's quiz",
        "description": "Create today's Still Streaming? quiz post manually",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/quiz-now"
      },
      {
        "label": "Post this week's prediction",
        "description": "Create the weekly prediction slate post manually",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/slate-now"
      },
      {
        "label": "Resolve last week's prediction",
        "description": "Score the previous weekly prediction against real departures",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/resolve-now"
      },
      {
        "label": "Reset all quiz data",
        "description": "Dev only: clear all stored quiz, slate, vote, score, streak and post state",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/reset-now"
      }
    ]
  },
  "dev": {
    "subreddit": "still_streaming_dev"
  }
}